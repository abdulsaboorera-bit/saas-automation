# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/socialpilot

# JWT
JWT_SECRET=your_jwt_secret_key_here_make_it_random_32_chars

# Meta (Instagram + Facebook)
META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# n8n Integration
N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_CALLBACK_SECRET=any_random_secret_string_here
N8N_API_KEY=your_n8n_api_key

# Storage (optional - for file uploads)
